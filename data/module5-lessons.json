      "section": 1,
      "content": {
        "characters": [
          { "malayalam": "ഉ", "iso15919": "u", "description": "Short 'u'. Like 'u' in 'put'.", "isNew": true },
          { "malayalam": "ഊ", "iso15919": "ū", "description": "Long 'ū'. Same vowel, held twice as long.", "isNew": true }
        ],
        "insight": "You now know four vowel pairs: a/ā, e/ē, o/ō, u/ū. The u and ū diacritics (seen in ലു, ലൂ) attach below-right of the consonant, similar to ā but lower.",
        "embeddedTask": {
          "label": "Quick check",
          "prompt": "Which one sounds longer?",
          "options": ["ഉ  (u)", "ഊ  (ū)"],
          "correct": 1
        }
      }
