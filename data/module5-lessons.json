      "type": "introduction",
      "completed": false,
      "section": 7,
      "content": {
        "steps": [
          {
            "heading": "What are chillus?",
            "characters": [
              { "malayalam": "ൽ", "iso15919": "l", "description": "Chillu L: alveolar lateral with no vowel. Used at the end of words.", "isNew": true },
              { "malayalam": "ൾ", "iso15919": "ḷ", "description": "Chillu Ḷ: retroflex lateral with no vowel. Used at the end of words.", "isNew": true }
            ],
            "embeddedTask": {
              "label": "Quick check",
              "prompt": "Which chillu comes from the retroflex lateral ള?",
              "options": ["ൽ  (l)", "ൾ  (ḷ)"],
              "correct": 1
            }
          },
          {
            "heading": "Match syllables to their chillus",
            "matchingExercise": [
              { "left": "ല",  "right": "ൽ",  "desc": "Alveolar lateral" },
              { "left": "ള",  "right": "ൾ",  "desc": "Retroflex lateral" }
            ]
          }
        ],
        "insight": "Like ൻ/ൺ from Module 3, these chillus are vowel-free forms of ല/ള. They appear only at the end of words, never at the start or middle."
      }
    },
