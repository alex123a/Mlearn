      "title": "Consonants ല (la) / ള (ḷa)",
      "type": "introduction",
      "completed": false,
      "section": 3,
      "content": {
        "characters": [
          { "malayalam": "ല", "iso15919": "la", "description": "Alveolar lateral. Tongue tip on the ridge behind upper teeth, like 'l' in 'leaf'.", "isNew": true },
          { "malayalam": "ള", "iso15919": "ḷa", "description": "Retroflex lateral. Tongue curls back, then makes contact: a deeper, darker 'l'.", "isNew": true }
        ],
        "insight": "ല and ള are both 'l' sounds: one dental, one retroflex. They follow the same dental/retroflex contrast as ത/ട and ന/ണ.",
        "embeddedTask": {
          "label": "Quick check",
          "prompt": "Which is the retroflex lateral (tongue curls back)?",
          "options": ["ല  (la)", "ള  (ḷa)"],
          "correct": 1
        }
      }
    },
