    {
      "id": 9,
      "category": "INTRODUCTION",
      "categoryName": "Syllables with ല (la) / ള (ḷa)",
      "title": "Syllables: u and ū with ല and ള",
      "type": "introduction",
      "completed": false,
      "section": 5,
      "content": {
        "steps": [
          {
            "heading": "ല + u-vowels",
            "characters": [
              { "malayalam": "ലു", "iso15919": "lu", "description": "Alveolar l + short u. The u-diacritic sits below-right." },
              { "malayalam": "ലൂ", "iso15919": "lū", "description": "Alveolar l + long ū. Longer form of the same sign." }
            ]
          },
          {
            "heading": "Now with ള (retroflex)",
            "characters": [
              { "malayalam": "ളു", "iso15919": "ḷu", "description": "Retroflex ḷ + short u." },
              { "malayalam": "ളൂ", "iso15919": "ḷū", "description": "Retroflex ḷ + long ū." }
            ],
            "embeddedTask": {
              "label": "Quick check",
              "prompt": "Which is 'ḷū' (retroflex lateral + long ū)?",
              "options": ["ലൂ", "ളൂ"],
              "correct": 1
            }
          },
          {
            "heading": "Match independent vowels to their signs",
            "matchingExercise": [
              { "left": "ഉ",  "right": "ലു", "desc": "Short 'u' sound" },
              { "left": "ഊ",  "right": "ലൂ", "desc": "Long 'ū' sound" }
            ]
          }
        ],
        "insight": "The u and ū diacritics attach below-right of the consonant. You now know diacritics that go left (e/ē), right (ā), both sides (o/ō), and below-right (u/ū)."
      }
    },
