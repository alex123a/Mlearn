{
  "module": 1,
  "title": "Vowels a/ā and Consonants ka/ma",
  "description": "Learn the first two vowels (short 'a' and long 'ā') and the first two consonants (k and m sounds). Discover how consonants carry a hidden 'a' sound.",
  "vowelsMixedIn": ["a", "aa"],
  "lessonSequence": [
    {
      "lessonId": "1.0-vowel-intro",
      "title": "Vowels: Short 'a' and Long 'ā'",
      "type": "introduction",
      "content": {
        "intro": "Every Malayalam word begins with a vowel. The first vowel sound is 'a'. Like the 'u' in English 'but'. But Malayalam has two versions: short and long.",
        "characters": [
          {
            "malayalam": "അ",
            "iso15919": "a",
            "audioPath": "/audio/vowels/a.mp3",
            "description": "Short 'a' sound. Quick and brief.",
            "isNew": true
          },
          {
            "malayalam": "ആ",
            "iso15919": "ā",
            "audioPath": "/audio/vowels/aa.mp3",
            "description": "Long 'ā' sound. Same vowel, but held longer. Like 'a' in 'father'.",
            "isNew": true
          }
        ],
        "insight": "Malayalam distinguishes between short and long vowels. 'a' is quick; 'ā' is held longer. This difference changes the meaning of words.",
        "animation": "Show 'a' with short duration, then 'ā' with extended duration"
      }
    },
    {
      "lessonId": "1.1-vowel-discrimination",
      "title": "Discrimination: Same or Different?",
      "type": "lesson",
      "taskType": "discrimination",
      "taskCount": 6,
      "content": {
        "intro": "You will hear two vowel sounds. Are they the same or different?",
        "tasks": [
          {
            "taskId": "disc-1",
            "sound1": "/audio/vowels/a.mp3",
            "sound2": "/audio/vowels/a.mp3",
            "correctAnswer": "same"
          },
          {
            "taskId": "disc-2",
            "sound1": "/audio/vowels/a.mp3",
            "sound2": "/audio/vowels/aa.mp3",
            "correctAnswer": "different"
          },
          {
            "taskId": "disc-3",
            "sound1": "/audio/vowels/aa.mp3",
            "sound2": "/audio/vowels/aa.mp3",
            "correctAnswer": "same"
          },
          {
            "taskId": "disc-4",
            "sound1": "/audio/vowels/aa.mp3",
            "sound2": "/audio/vowels/a.mp3",
            "correctAnswer": "different"
          },
          {
            "taskId": "disc-5",
            "sound1": "/audio/vowels/a.mp3",
            "sound2": "/audio/vowels/aa.mp3",
            "correctAnswer": "different"
          },
          {
            "taskId": "disc-6",
            "sound1": "/audio/vowels/aa.mp3",
            "sound2": "/audio/vowels/aa.mp3",
            "correctAnswer": "same"
          }
        ]
      }
    },
    {
