    {
      "id": 9,
      "category": "INTRODUCTION",
      "categoryName": "Syllables ക (ka) / കാ (kā) / മ (ma) / മാ (mā)",
      "title": "Syllables ക (ka) / കാ (kā) / മ (ma) / മാ (mā)",
      "type": "introduction",
      "completed": false,
      "section": 5,
      "content": {
        "steps": [
          {
            "heading": "Two forms of every vowel",
            "characters": [
              { "malayalam": "ആ", "iso15919": "ā", "description": "Independent vowel letter. Used only at the start of a word, like ആമ (āma, tortoise)." },
              { "malayalam": "കാ", "iso15919": "kā", "description": "Vowel sign (ാ) written on a consonant. Used everywhere else inside a word." }
            ]
          },
          {
            "heading": "ക + both vowels",
            "characters": [
              { "malayalam": "ക",  "iso15919": "ka", "description": "Inherent 'a', no sign needed." },
              { "malayalam": "കാ", "iso15919": "kā", "description": "Add ā vowel sign (ാ) to the right." }
            ]
          },
          {
            "heading": "Now with മ",
            "characters": [
              { "malayalam": "മ",  "iso15919": "ma", "description": "Inherent 'a'." },
              { "malayalam": "മാ", "iso15919": "mā", "description": "Add ā vowel sign to get 'mā'." }
            ],
            "embeddedTask": {
              "label": "Quick check",
              "prompt": "Which of these is 'mā'?",
              "options": ["മ", "മാ"],
              "correct": 1
            }
          },
          {
            "heading": "Match independent vowels to their signs",
            "matchingExercise": [
              { "left": "അ",  "right": "ക",  "desc": "Inherent 'a' sound" },
              { "left": "ആ",  "right": "കാ", "desc": "Long 'ā' sound" }
            ]
          }
        ],
        "insight": "Every vowel has two forms: an independent letter (word-initial) and a vowel sign (written on a consonant). You already know the independent vowels അ and ആ. The ā vowel sign (ാ) is the same sound written as a mark on the right side of a consonant."
      }
    },
