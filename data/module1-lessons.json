    {
      "lessonId": "1.8-syllable-intro",
      "title": "Syllables: Consonant + Vowel",
      "type": "introduction",
      "content": {
        "intro": "Now combine consonants with vowels. When you add a vowel to a consonant, something changes: the hidden 'a' gets replaced.",
        "examples": [
          {
            "step1": "ക (ka — has hidden 'a')",
            "step2": "+ ാ (the vowel 'ā')",
            "step3": "= കാ (kā — the hidden 'a' is replaced by 'ā')",
            "animation": "Show ക, then add ാ on top, show the transformation"
          },
          {
            "step1": "മ (ma — has hidden 'a')",
            "step2": "+ ാ (the vowel 'ā')",
            "step3": "= മാ (mā — the hidden 'a' is replaced by 'ā')",
            "animation": "Show മ, then add ാ on top, show the transformation"
          }
        ],
        "insight": "When a vowel diacritic is added to a consonant, it replaces the default 'a' sound. This pattern applies to all Malayalam words.",
        "visualPattern": "Highlight that ാ is a mark added below or beside the consonant"
      }
    },
