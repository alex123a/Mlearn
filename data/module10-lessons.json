      "id": 8,
      "category": "INTRODUCTION",
      "categoryName": "Consonant Clusters ണ്ട / ങ്ങ / ക്ഷ",
      "title": "Consonant Clusters: ണ്ട, ങ്ങ, ക്ഷ",
      "type": "introduction",
      "completed": false,
      "section": 4,
      "content": {
        "steps": [
          {
            "heading": "How clusters form: virama joins two consonants",
            "characters": [
              { "malayalam": "ണ്ട", "iso15919": "ṇṭa", "description": "ണ + ് + ട — retroflex n joins retroflex t. Very common in Malayalam." },
              { "malayalam": "ങ്ങ", "iso15919": "ṅṅa", "description": "ങ + ് + ങ — the velar nasal doubled. Common double nasal." },
              { "malayalam": "ക്ഷ", "iso15919": "kṣa", "description": "ക + ് + ഷ — k joins retroflex sh. Common in Sanskrit loanwords." }
            ],
            "matchingExercise": [
              { "left": "ണ + ട", "right": "ണ്ട  (ṇṭa)", "desc": "retroflex n + retroflex t" },
              { "left": "ങ + ങ", "right": "ങ്ങ  (ṅṅa)", "desc": "velar nasal doubled" },
              { "left": "ക + ഷ", "right": "ക്ഷ  (kṣa)", "desc": "k + retroflex sh" }
            ]
          }
        ],
        "insight": "Consonant clusters are formed when one consonant loses its vowel (via virama) and joins the next. The result is written as a single combined shape. ണ്ട and ക്ഷ are among the most common clusters in everyday Malayalam."
      }
    },
