      "section": 5,
      "content": {
        "steps": [
          {
            "heading": "പ + the o-vowels",
            "characters": [
              { "malayalam": "പൊ", "iso15919": "po", "description": "Bilabial p + short o. Sign wraps: left part + right part around the consonant." },
              { "malayalam": "പോ", "iso15919": "pō", "description": "Bilabial p + long ō. Longer wrap sign." }
            ]
          },
          {
            "heading": "Now with വ",
            "characters": [
              { "malayalam": "വൊ", "iso15919": "vo", "description": "Labiodental v + short o." },
              { "malayalam": "വോ", "iso15919": "vō", "description": "Labiodental v + long ō." }
            ],
            "embeddedTask": {
              "label": "Quick check",
              "prompt": "Which is 'vō' (v + long ō)?",
              "options": ["വൊ", "വോ"],
              "correct": 1
            }
          },
          {
            "heading": "Match independent vowels to their signs",
            "matchingExercise": [
              { "left": "ഒ",  "right": "പൊ", "desc": "Short 'o' sound" },
              { "left": "ഓ",  "right": "പോ", "desc": "Long 'ō' sound" }
            ]
          }
        ],
        "insight": "The o/ō diacritics wrap around both sides of the consonant — a left part and a right part together. This is unique among the vowels you have learned."
      }
