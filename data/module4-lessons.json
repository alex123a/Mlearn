      "type": "introduction",
      "completed": false,
      "section": 7,
      "content": {
        "steps": [
          {
            "heading": "All Malayalam vowels at a glance",
            "matchingExercise": [
              { "left": "അ",  "right": "ക",  "desc": "a" },
              { "left": "ആ",  "right": "കാ", "desc": "ā" },
              { "left": "എ",  "right": "കെ", "desc": "e" },
              { "left": "ഏ",  "right": "കേ", "desc": "ē" },
              { "left": "ഒ",  "right": "കൊ", "desc": "o" },
              { "left": "ഓ",  "right": "കോ", "desc": "ō" }
            ],
            "vowelSystemTable": true
          }
        ],
        "insight": "You have learned all six basic vowels. Each has two forms: an independent letter (used word-initially) and a vowel sign (used on consonants). The signs attach in different directions: right (ā), left (e/ē), both sides (o/ō), and no visible sign (a)."
      }
