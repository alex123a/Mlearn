      "section": 3,
      "content": {
        "characters": [
          { "malayalam": "പ", "iso15919": "pa", "description": "Bilabial stop. Both lips close, then release — like 'p' in 'spin'.", "isNew": true },
          { "malayalam": "വ", "iso15919": "va", "description": "Labiodental approximant. Upper teeth lightly touch lower lip, like 'v' in 'vine'.", "isNew": true }
        ],
        "insight": "Both are labial consonants, made at or near the lips. പ is a stop (complete closure); വ is a glide (partial contact).",
        "embeddedTask": {
          "label": "Quick check",
          "prompt": "Which letter makes the 'v' sound?",
          "options": ["പ  (pa)", "വ  (va)"],
          "correct": 1
