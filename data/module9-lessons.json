    {
      "id": 8,
      "category": "INTRODUCTION",
      "categoryName": "Double Consonant Ligatures ക്ക / ട്ട / ത്ത / ന്ന / മ്മ",
      "title": "Double Consonant Ligatures: ക്ക, ട്ട, ത്ത, ന്ന, മ്മ",
      "type": "introduction",
      "completed": false,
      "section": 4,
      "content": {
        "steps": [
          {
            "heading": "What is a double consonant ligature?",
            "characters": [
              { "malayalam": "ക്ക", "iso15919": "kka", "description": "ക + ് + ക — the same consonant twice. First loses its vowel via virama; second keeps the inherent 'a'." }
            ]
          },
          {
            "heading": "All five double forms",
            "characters": [
              { "malayalam": "ക്ക", "iso15919": "kka", "description": "k + k" },
              { "malayalam": "ട്ട", "iso15919": "ṭṭa", "description": "ṭ + ṭ — retroflex t doubled" },
              { "malayalam": "ത്ത", "iso15919": "tta", "description": "t + t — dental t doubled" },
              { "malayalam": "ന്ന", "iso15919": "nna", "description": "n + n — alveolar n doubled" },
              { "malayalam": "മ്മ", "iso15919": "mma", "description": "m + m" }
            ],
            "matchingExercise": [
              { "left": "ക  (ka)", "right": "ക്ക  (kka)", "desc": "k + virama + k" },
              { "left": "ട  (ṭa)", "right": "ട്ട  (ṭṭa)", "desc": "ṭ + virama + ṭ" },
              { "left": "ത  (ta)", "right": "ത്ത  (tta)", "desc": "t + virama + t" },
              { "left": "ന  (na)", "right": "ന്ന  (nna)", "desc": "n + virama + n" },
              { "left": "മ  (ma)", "right": "മ്മ  (mma)", "desc": "m + virama + m" }
            ]
          }
        ],
        "insight": "When the same consonant appears twice in a row, Malayalam writes it as a joined ligature using virama. The shape changes, but the sound is a geminate — a doubled or held consonant."
      }
    },
