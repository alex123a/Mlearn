    {
      "id": 9,
      "category": "INTRODUCTION",
      "categoryName": "Syllables തെ (te) / തേ (tē) / ടെ (ṭe) / ടേ (ṭē)",
      "title": "Syllables: e and ē with ത and ട",
      "type": "introduction",
      "completed": false,
      "section": 5,
      "content": {
        "steps": [
          {
            "heading": "Two forms of e and ē (as with ā)",
            "characters": [
              { "malayalam": "എ", "iso15919": "e",  "description": "Independent vowel letter, used only at the start of a word, like എണ്ണ (oil)." },
              { "malayalam": "തെ", "iso15919": "te", "description": "Vowel sign (െ) written to the LEFT of the consonant. Used inside words." }
            ]
          },
          {
            "heading": "ത + both e-vowels",
            "characters": [
              { "malayalam": "തെ", "iso15919": "te", "description": "e vowel sign sits to the LEFT of the consonant." },
              { "malayalam": "തേ", "iso15919": "tē", "description": "ē vowel sign also to the left, longer sound." }
            ]
          },
          {
            "heading": "Now with ട",
            "characters": [
              { "malayalam": "ടെ", "iso15919": "ṭe", "description": "Retroflex ṭ + short e." },
              { "malayalam": "ടേ", "iso15919": "ṭē", "description": "Retroflex ṭ + long ē." }
            ],
            "embeddedTask": {
              "label": "Quick check",
              "prompt": "Which is 'ṭē'?",
              "options": ["തേ", "ടേ"],
              "correct": 1
            }
          },
          {
            "heading": "Match independent vowels to their signs",
            "matchingExercise": [
              { "left": "എ",  "right": "തെ", "desc": "Short 'e' sound" },
              { "left": "ഏ",  "right": "തേ", "desc": "Long 'ē' sound" }
            ]
          }
        ],
        "insight": "Like ā, the vowels e and ē each have two forms: an independent letter (word-initial) and a vowel sign (written on a consonant). Unlike the ā sign which goes to the right, the e and ē signs attach to the LEFT. In തെ the sign appears before the consonant visually, but the sound is still 'te'."
      }
    },
