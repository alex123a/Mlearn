    {
      "id": 13,
      "category": "LESSON",
      "categoryName": "Chandrakkala (്)",
      "title": "Chandrakkala: removing the inherent vowel",
      "type": "introduction",
      "completed": false,
      "section": 7,
      "content": {
        "steps": [
          {
            "heading": "What chandrakkala does",
            "characters": [
              { "malayalam": "ക",  "iso15919": "ka", "description": "Every consonant carries an inherent 'a' sound. ക alone is read 'ka'." },
              { "malayalam": "ക്", "iso15919": "k",  "description": "Chandrakkala (്) removes the inherent vowel. ക് is a pure 'k' with no following vowel." }
            ]
          },
          {
            "heading": "All four consonants with chandrakkala",
            "characters": [
              { "malayalam": "ക്", "iso15919": "k",  "description": "ka → k. The small curved mark below removes the 'a'." },
              { "malayalam": "മ്", "iso15919": "m",  "description": "ma → m. Same mark, same effect on മ." },
              { "malayalam": "ത്", "iso15919": "t",  "description": "ta → t. Dental t with no vowel." },
              { "malayalam": "ട്", "iso15919": "ṭ",  "description": "ṭa → ṭ. Retroflex ṭ with no vowel." }
            ],
            "embeddedTask": {
              "label": "Quick check",
              "prompt": "What does chandrakkala (്) do to a consonant?",
              "options": [
                "Adds a long ā vowel",
                "Removes the inherent 'a' vowel",
                "Changes the consonant to a different sound"
              ],
              "correct": 1
            }
          }
        ],
        "insight": "Chandrakkala (്) has two roles. Inside a word it joins two consonants into a cluster: ക + ത് = കത് (the k clings to the t). At the end of a word it leaves a very short half-vowel: ക (ka) becomes ക് (kŭ), where ŭ is a faint echo-vowel. You will practise both uses in later lessons."
      }
    },
